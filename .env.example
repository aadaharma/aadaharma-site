# Copy to .env.local, or run `npx vercel env pull .env.local`.
# Without DATABASE_URL, patterns are read from content/patterns/*.md.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# The admin login (/admin/): a password of 20+ characters and a random secret of 32+
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
